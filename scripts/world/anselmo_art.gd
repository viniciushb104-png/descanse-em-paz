extends RefCounted
const PNG = {"front":"","back":"","left":"","right":""}
static func texture(direction: String) -> Texture2D:
    var img := Image.new()
    var bytes := Marshalls.base64_to_raw(str(PNG.get(direction,PNG["front"])))
    if img.load_png_from_buffer(bytes)!=OK or img.is_empty():
        return null
    img.convert(Image.FORMAT_RGBA8)
    return ImageTexture.create_from_image(img)
